# Copy this file to `.env` and adjust the values for your environment.

# --- Application ---------------------------------------------------------
PROJECT_NAME="{{ cookiecutter.project_name }}"
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_JSON=false             # true for structured JSON logs
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true          # serve /docs, /redoc and the OpenAPI schema

# --- Database (async SQLAlchemy URL) ------------------------------------
# Start PostgreSQL locally first:  docker compose up -d db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ cookiecutter.package_name }}
DB_ECHO=false

# --- CORS / trusted hosts (comma-separated) -----------------------------
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*            # restrict to your domain(s) in production
{%- if cookiecutter.use_auth == "yes" %}

# --- Security ------------------------------------------------------------
# REQUIRED outside local: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
{%- endif %}
{%- if cookiecutter.use_rate_limiting == "yes" %}

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT=100/minute
{%- endif %}
{%- if cookiecutter.use_sentry == "yes" %}

# --- Sentry --------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
{%- endif %}
{%- if cookiecutter.use_temporal == "yes" %}

# --- Temporal ------------------------------------------------------------
TEMPORAL_HOST=localhost:7233   # temporal:7233 when running via docker-compose
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE={{ cookiecutter.package_name }}-tq
{%- endif %}
