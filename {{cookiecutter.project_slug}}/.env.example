# Copy this file to `.env` and adjust the values for your environment.

# --- Application ---------------------------------------------------------
PROJECT_NAME="{{ cookiecutter.project_name }}"
ENVIRONMENT=local          # local | staging | production
DEBUG=false                # must be false in production; the app refuses to boot otherwise
LOG_JSON=false             # true for structured JSON logs
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Serve /docs, /redoc and the OpenAPI schema. Defaults to false in production
# unless set explicitly.
DOCS_ENABLED=true

# --- Database (async SQLAlchemy URL) ------------------------------------
{%- if cookiecutter.use_docker == "yes" %}
# Start PostgreSQL locally first:  docker compose up -d db
# Password for the compose-managed PostgreSQL. docker-compose.yml interpolates
# this into the db service and into every in-compose DATABASE_URL (fallback
# "postgres" when unset). If you change it, keep the password in DATABASE_URL
# below in sync.
POSTGRES_PASSWORD=postgres
{%- else %}
# Requires a locally running PostgreSQL instance.
{%- endif %}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ cookiecutter.package_name }}
DB_ECHO=false

# --- CORS / trusted hosts (comma-separated) -----------------------------
CORS_ORIGINS=http://localhost:3000
# Required in production: explicit hostnames, no '*' (the app refuses to boot otherwise).
ALLOWED_HOSTS=*
{%- if cookiecutter.use_auth == "yes" %}

# --- Security ------------------------------------------------------------
# ENFORCED outside local (staging AND production): must be non-default and at
# least 32 characters, or the app refuses to boot.
# Generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Allow unauthenticated signup via POST /auth/register. Set to false for
# invite-only or internal deployments (register then returns 403).
OPEN_REGISTRATION=true

# --- Email (password recovery + verification) ----------------------------
# With EMAILS_ENABLED=false outbound email is logged instead of sent, so local
# development needs no SMTP server. EMAILS_ENABLED=true requires SMTP_HOST
# (the app refuses to boot otherwise).
EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# From address for outbound email; falls back to the project contact email.
EMAILS_FROM_EMAIL=
# Base URL for the links embedded in emails (/reset-password, /verify-email).
FRONTEND_URL=http://localhost:3000
EMAIL_TOKEN_EXPIRE_MINUTES=60
# Block login until the address is verified; registration then sends a
# verification email.
REQUIRE_EMAIL_VERIFICATION=false
{%- endif %}
{%- if cookiecutter.use_rate_limiting == "yes" %}

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT=100/minute
{%- endif %}
{%- if cookiecutter.use_sentry == "yes" %}

# --- Sentry --------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
{%- endif %}
{%- if cookiecutter.use_temporal == "yes" %}

# --- Temporal ------------------------------------------------------------
TEMPORAL_HOST=localhost:7233   # temporal:7233 when running via docker-compose
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE={{ cookiecutter.package_name }}-tq
{%- endif %}
{%- if cookiecutter.use_redis == "yes" %}

# --- Redis (cache + events) ----------------------------------------------
REDIS_URL=redis://localhost:6379/0   # redis://redis:6379/0 when running via docker-compose
# Approximate hard cap on the events stream; the consumer trims processed
# entries (XTRIM MINID), so this only bounds unprocessed backlog.
REDIS_STREAM_MAXLEN=1000000
{%- endif %}
