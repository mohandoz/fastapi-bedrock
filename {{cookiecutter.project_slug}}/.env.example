# Copy this file to `.env` and adjust the values for your environment.

# --- Application ---------------------------------------------------------
PROJECT_NAME="{{ cookiecutter.project_name }}"
ENVIRONMENT=local          # local | staging | production
DEBUG=false                # must be false in production; the app refuses to boot otherwise
LOG_JSON=false             # true for structured JSON logs
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Serve /docs, /redoc and the OpenAPI schema. Defaults to false in production
# unless set explicitly.
DOCS_ENABLED=true

# --- Database (async SQLAlchemy URL) ------------------------------------
{%- if cookiecutter.use_docker == "yes" %}
# Start PostgreSQL locally first:  docker compose up -d db
# Password for the compose-managed PostgreSQL. docker-compose.yml interpolates
# this into the db service and into every in-compose DATABASE_URL (fallback
# "postgres" when unset). If you change it, keep the password in DATABASE_URL
# below in sync.
POSTGRES_PASSWORD=postgres
{%- else %}
# Requires a locally running PostgreSQL instance.
{%- endif %}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ cookiecutter.package_name }}
# Auto-create tables at startup (local convenience only; forced off outside local).
# Real deployments apply schema with Alembic: make migrate
# DB_AUTO_CREATE=true
DB_ECHO=false
# Connection pool and timeouts (defaults shown; timeouts are seconds unless _MS).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10.0
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=5000

# --- Runtime limits (defaults shown) -------------------------------------
# Reject request bodies above this many bytes with a 413 (2 MiB).
# MAX_BODY_SIZE=2097152
# Cancel non-streaming requests running longer than this (seconds) with a 504.
# REQUEST_TIMEOUT=30.0
# Budget (seconds) for each dependency check inside the /ready probe.
# READINESS_CHECK_TIMEOUT=2.0

# --- CORS / trusted hosts (comma-separated) -----------------------------
CORS_ORIGINS=http://localhost:3000
# Required in production: explicit hostnames, no '*' (the app refuses to boot otherwise).
{%- if cookiecutter.use_docker == "yes" %}
# Keep "localhost" in the list: the container healthcheck and k8s probes send Host: localhost.
{%- endif %}
ALLOWED_HOSTS=*
{%- if cookiecutter.use_auth == "yes" %}

# --- Security ------------------------------------------------------------
# ENFORCED outside local (staging AND production): must be non-default and at
# least 32 characters, or the app refuses to boot.
# Generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-secret
# ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Allow unauthenticated signup via POST /auth/register. Set to false for
# invite-only or internal deployments (register then returns 403).
OPEN_REGISTRATION=true
# JWT audience/issuer binding: reject tokens minted by another service that
# shares the same SECRET_KEY (defaults shown).
# JWT_ISSUER={{ cookiecutter.package_name }}
# JWT_AUDIENCE={{ cookiecutter.package_name }}
# Superuser account created (or promoted) at startup. Set both or neither.
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=change-me

# --- Email (password recovery + verification) ----------------------------
# With EMAILS_ENABLED=false outbound email is logged instead of sent, so local
# development needs no SMTP server. EMAILS_ENABLED=true requires SMTP_HOST
# (the app refuses to boot otherwise).
EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# From address for outbound email; falls back to the project contact email.
EMAILS_FROM_EMAIL=
# Base URL for the links embedded in emails (/reset-password, /verify-email).
FRONTEND_URL=http://localhost:3000
EMAIL_TOKEN_EXPIRE_MINUTES=60
# Block login until the address is verified; registration then sends a
# verification email.
REQUIRE_EMAIL_VERIFICATION=false
{%- endif %}
{%- if cookiecutter.use_rate_limiting == "yes" %}

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT=100/minute
{%- endif %}
{%- if cookiecutter.use_sentry == "yes" %}

# --- Sentry --------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
{%- endif %}
{%- if cookiecutter.use_temporal == "yes" %}

# --- Temporal ------------------------------------------------------------
TEMPORAL_HOST=localhost:7233   # temporal:7233 when running via docker-compose
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE={{ cookiecutter.package_name }}-tq
{%- endif %}
{%- if cookiecutter.use_redis == "yes" %}

# --- Redis (cache + events) ----------------------------------------------
REDIS_URL=redis://localhost:6379/0   # redis://redis:6379/0 when running via docker-compose
REDIS_MAX_CONNECTIONS=20
CACHE_DEFAULT_TTL=300                # seconds
REDIS_STREAM={{ cookiecutter.package_name }}:events
REDIS_CONSUMER_GROUP={{ cookiecutter.package_name }}-workers
# Approximate hard cap on the events stream; the consumer trims processed
# entries (XTRIM MINID), so this only bounds unprocessed backlog.
REDIS_STREAM_MAXLEN=1000000
{%- endif %}
{%- if cookiecutter.use_observability == "yes" %}

# --- Observability (OpenTelemetry / OTLP) --------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME={{ cookiecutter.package_name }}
# Base OTLP endpoint; exporters append /v1/traces, /v1/metrics, /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
{%- endif %}
{%- if cookiecutter.use_http_client == "yes" %}

# --- Resilient HTTP client (outbound calls) ------------------------------
HTTP_TIMEOUT=10.0
HTTP_RETRIES=3
HTTP_BREAKER_FAILURE_THRESHOLD=5
HTTP_BREAKER_RESET_TIMEOUT=30.0
{%- endif %}
